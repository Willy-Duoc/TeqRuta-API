# Servidor
PORT=5000
FLASK_DEBUG=true
SECRET_KEY=cambia-esta-clave-en-produccion
JWT_SECRET_KEY=cambia-este-secreto-jwt-en-produccion
JWT_EXPIRE_HOURS=8
CORS_ORIGINS=*

# Base de datos (SQLite por defecto; usa postgres+psycopg://... en producción)
DATABASE_URL=sqlite:///teqruta.db

# Datos de demostración (desactivar en producción)
SEED_DEMO_USERS=true

# Fuente pública de precios de combustible (datos CNE vía AhorraHogar.cl)
FUEL_PRICE_URL=https://ahorrahogar.cl/datos/datos.json
FUEL_PRICE_TIMEOUT=5
FUEL_PRICE_CACHE_HOURS=24
FUEL_REGION_CODE=8
FUEL_DEFAULT_PRICE=1597
COSTO_COMBUSTIBLE_TIPO=93

# Motor de cálculo
DEFAULT_RENDIMIENTO_KM_L=10
DESVIACION_UMBRAL_PCT=10
