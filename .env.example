# Servidor
# HOST=127.0.0.1 deja el puerto solo en loopback: Ngrok es la única salida pública.
HOST=127.0.0.1
PORT=5000
# En desarrollo manual puedes usar true; `tunel.py` fuerza false para tener un solo proceso.
FLASK_DEBUG=false
TRUST_PROXY=true
# Opcional: URL canónica si publicas con un dominio reservado.
# PUBLIC_BASE_URL=https://teqruta-demo.ngrok-free.dev
SECRET_KEY=cambia-esta-clave-en-produccion
JWT_SECRET_KEY=cambia-este-secreto-jwt-en-produccion
JWT_EXPIRE_HOURS=8
CORS_ORIGINS=*

# Ngrok (salida pública HTTPS)
# Token: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Opcional pero recomendado: dominio estático de tu cuenta Ngrok.
# Sin dominio, el plan gratuito puede cambiar la URL en cada inicio y habría
# que recompilar el APK. Ejemplo: teqruta-demo.ngrok-free.dev
NGROK_DOMAIN=

# Ruta del proyecto Android si no está en ../TeqRuta.
# También puedes pasarla con `make publicar` usando TEQRUTA_APP_DIR=...
# TEQRUTA_APP_DIR=/ruta/a/TeqRuta

# Base de datos (SQLite por defecto).
# PostgreSQL en producción: DATABASE_URL=postgresql+psycopg://usuario:clave@host:5432/teqruta
# (instala el driver con: pip install "psycopg[binary]")
DATABASE_URL=sqlite:///teqruta.db

# Datos de demostración (desactivar en producción)
SEED_DEMO_USERS=true

# Fuente pública de precios de combustible (datos CNE vía AhorraHogar.cl)
FUEL_PRICE_URL=https://ahorrahogar.cl/datos/datos.json
FUEL_PRICE_TIMEOUT=5
FUEL_PRICE_CACHE_HOURS=24
FUEL_REGION_CODE=8
FUEL_DEFAULT_PRICE=1597
COSTO_COMBUSTIBLE_TIPO=93

# Motor de cálculo
DEFAULT_RENDIMIENTO_KM_L=10
DESVIACION_UMBRAL_PCT=10
