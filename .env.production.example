# Plantilla de producción. Copia a .env.production y no la versiones.
#   cp .env.production.example .env.production
#   python3 scripts/preparar_env_produccion.py   # genera secretos y clave PG
#
# Los comandos de Docker Compose deben usar este archivo para interpolar
# POSTGRES_*:
#   docker compose --env-file .env.production up -d --build

APP_ENV=production

# Flask / sesión del panel. Mínimo 32 caracteres aleatorios.
SECRET_KEY=cambia-esta-clave-en-produccion
JWT_SECRET_KEY=cambia-este-secreto-jwt-en-produccion
JWT_EXPIRE_HOURS=8
SESSION_HOURS=8
SESSION_COOKIE_SECURE=true

# Detrás de Nginx; las cabeceras X-Forwarded-* son confiables.
TRUST_PROXY=true
PREFERRED_URL_SCHEME=https

# PostgreSQL del stack Docker. La contraseña debe ser alfanumérica o estar
# codificada para URL (%40, %3A, ...) porque se inserta en DATABASE_URL.
# DATABASE_URL la construye docker-compose.yml a partir de estas variables.
POSTGRES_DB=teqruta
POSTGRES_USER=teqruta
POSTGRES_PASSWORD=cambia-esta-clave-postgres

# Puertos públicos de Nginx (deja 80/443 salvo que ya estén ocupados).
HTTP_PORT=80
HTTPS_PORT=443

# La base se inicializa con `make prod-init` y un administrador con
# `make prod-admin`; nunca se cargan datos demo en producción.
AUTO_CREATE_DB=false
SEED_DEMO_USERS=false

# Orígenes permitidos para la API móvil (la app Android no envía Origin).
CORS_ORIGINS=*

# Sentry es opcional: si queda vacío no se envía nada.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=teqruta-api@1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false

# Combustible y motor de cálculo.
FUEL_PRICE_URL=https://ahorrahogar.cl/datos/datos.json
FUEL_PRICE_TIMEOUT=5
FUEL_PRICE_CACHE_HOURS=24
FUEL_REGION_CODE=8
FUEL_DEFAULT_PRICE=1597
COSTO_COMBUSTIBLE_TIPO=93
DEFAULT_RENDIMIENTO_KM_L=10
DESVIACION_UMBRAL_PCT=10
